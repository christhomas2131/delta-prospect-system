# Delta Prospect System — Environment Variables
# Copy to .env for local development. On Railway, set these in the dashboard.

# Database connection (Railway provides this automatically)
# For local dev with individual params:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=delta_prospect
DB_USER=delta
DB_PASSWORD=delta_dev
# Or use a full connection string (takes priority over individual params):
# DATABASE_URL=postgresql://delta:delta_dev@localhost:5432/delta_prospect

# Server port (Railway sets this automatically — do not hardcode in production)
PORT=8000

# Authentication (leave blank to disable auth for local dev)
AUTH_USER=
AUTH_PASSWORD=

# CORS (comma-separated origins, or * for dev)
ALLOWED_ORIGINS=*

# Optional: Anthropic API key for Deep Analysis feature
ANTHROPIC_API_KEY=

# Optional: Firecrawl API key for V3 full-document intelligence
FIRECRAWL_API_KEY=

# Contact enrichment. Hunter is primary; Apollo is an optional fallback.
HUNTER_API_KEY=
APOLLO_API_KEY=

# Cron endpoint secret (protects /api/cron/enrich-all from unauthorized access)
CRON_SECRET=

# Optional: automatic daily ASX refresh on the app server
AUTO_ASX_REFRESH_ENABLED=true
AUTO_ASX_REFRESH_TIMEZONE=Australia/Sydney
AUTO_ASX_REFRESH_HOUR=9
AUTO_ASX_REFRESH_MINUTE=0

# ---------------------------------------------------------------------------
# Phase 1-5 operations settings (all optional; defaults shown)
# ---------------------------------------------------------------------------
# Process roles. One container runs API + worker thread + scheduler by default.
# Scaling out: keep RUN_WORKER/SCHEDULER_ENABLED=true on exactly one replica,
# or set RUN_WORKER=false everywhere and run `python worker.py` separately.
RUN_WORKER=true
SCHEDULER_ENABLED=true
# Apply pending migrations at startup (false = refuse to start if any are pending)
AUTO_MIGRATE=true
# Snapshot seeding: insert_missing (default) | overwrite (never touches analyst-edited rows)
SNAPSHOT_SEED_MODE=insert_missing
# APP_ENV=production enables the "no auth configured" warning (auto-set on Railway)
APP_ENV=
# Logging: plain | json ; LOG_LEVEL=INFO
LOG_FORMAT=plain

# AI spend controls (USD). 0 = no ceiling. Estimates use list prices below.
AI_MONTHLY_BUDGET_USD=0
AI_PRICE_INPUT_PER_M=3.0
AI_PRICE_OUTPUT_PER_M=15.0
AI_CACHE_MAX_AGE_DAYS=30

# Alerts: Slack/Teams-compatible webhook receiving {"text": ...} for warnings/errors
ALERT_WEBHOOK_URL=
